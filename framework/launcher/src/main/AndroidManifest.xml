<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".BreadBoardLauncherActivity"
            android:exported="true"
            android:icon="@drawable/breadboard"
            android:label="@string/bread_board"
            android:theme="@style/Theme.BreadBoard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BreadBoardLauncherWithInstrumentationActivity"
            android:theme="@style/Theme.BreadBoard" />
        <activity
            android:name=".BreadBoardLauncherActivityForDI"
            android:theme="@style/Theme.BreadBoard" />
    </application>

</manifest>